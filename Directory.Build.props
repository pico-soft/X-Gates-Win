<Project>
  <!-- Общие свойства всех C#-проектов X-Gates Win (Android-модуль app/ — Gradle, сюда не относится). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>PICO-SOFT</Company>
    <Product>X-Gates Win</Product>
    <Version>0.6.0</Version>
    <!-- Целое, растёт с КАЖДЫМ релизом: обновлялка сравнивает ТОЛЬКО его (как versionCode Android). -->
    <VersionCode>6</VersionCode>
    <VersionNameDisplay>0.6 beta</VersionNameDisplay>
    <!-- Сборка Windows-проектов на Linux-сервере разработки (см. docs/decisions.md §13.1). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="VersionCode" Value="$(VersionCode)" />
    <AssemblyMetadata Include="VersionNameDisplay" Value="$(VersionNameDisplay)" />
  </ItemGroup>
</Project>
