Subject: [PATCH] =?UTF-8?q?fix(config):=20splithttp=20(=D1=81=D1=82=D0=B0?=
 =?UTF-8?q?=D1=80=D0=BE=D0=B5=20=D0=B8=D0=BC=D1=8F=20xhttp)=20=D0=BF=D0=B0?=
 =?UTF-8?q?=D0=B4=D0=B0=D0=BB=20=C2=ABunsupported=20transport=C2=BB=20?=
 =?UTF-8?q?=E2=80=94=20=D0=BD=D0=BE=D1=80=D0=BC=D0=B0=D0=BB=D0=B8=D0=B7?=
 =?UTF-8?q?=D1=83=D0=B5=D0=BC=20=D0=B2=20xhttp?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

JsonConfigParser отдаёт network="splithttp" (и ссылки type=splithttp), а XrayConfigBuilder такого имени не знал
→ build() бросал IllegalArgumentException, сервер не собирался. Теперь splithttp — синоним xhttp (как raw→tcp,
kcp→mkcp): в конфиг идёт network xhttp + xhttpSettings (path/host/mode). Профиль не трогаем (serverKey стабилен).

Найдено при порте на Windows (X-Gates-Win, docs/decisions.md «Найдено в Android-коде» №1).
---
 .../picosoft/xrayproxydroid/xray/XrayConfigBuilder.kt |  7 ++++---
 .../com/picosoft/xrayproxydroid/TransportBuildTest.kt | 11 +++++++++++
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/app/src/main/java/com/picosoft/xrayproxydroid/xray/XrayConfigBuilder.kt b/app/src/main/java/com/picosoft/xrayproxydroid/xray/XrayConfigBuilder.kt
index 6c94553..cbaea31 100644
--- a/app/src/main/java/com/picosoft/xrayproxydroid/xray/XrayConfigBuilder.kt
+++ b/app/src/main/java/com/picosoft/xrayproxydroid/xray/XrayConfigBuilder.kt
@@ -17,9 +17,9 @@ object XrayConfigBuilder {
     // Транспорты, которые собираем И которые умеет наше ядро (проверено по бинарю AAR, xray-core v26.x:
     // rawSettings/xhttpSettings/httpupgradeSettings/kcpSettings присутствуют). quic ядром НЕ поддержан (нет пакета).
     //  • raw   — новое имя tcp (нормализуем raw→tcp);
-    //  • xhttp — новое имя splithttp (ядро принимает оба имени + xhttpSettings);
+    //  • xhttp — новое имя splithttp (нормализуем splithttp→xhttp: иначе xhttpSettings не пишутся и path теряется);
     //  • kcp/mkcp — одно и то же (нормализуем kcp→mkcp).
-    private val SUPPORTED_NETWORKS = setOf("tcp", "raw", "ws", "grpc", "xhttp", "httpupgrade", "kcp", "mkcp")
+    private val SUPPORTED_NETWORKS = setOf("tcp", "raw", "ws", "grpc", "xhttp", "splithttp", "httpupgrade", "kcp", "mkcp")
 
     /** Боевой конфиг: общий inbound (socks 10815 + http 10816) + outbound сервера. */
     fun build(p: ServerProfile): String = """
@@ -150,9 +150,10 @@ object XrayConfigBuilder {
     // --- streamSettings (общий для vless/vmess/trojan) ---
 
     private fun streamSettings(p: ServerProfile): String {
-        // Нормализация имён-синонимов транспорта: raw→tcp (raw = переименованный tcp), kcp→mkcp.
+        // Нормализация имён-синонимов транспорта: raw→tcp (raw = переименованный tcp), splithttp→xhttp, kcp→mkcp.
         val net = when (p.network) {
             "raw" -> "tcp"
+            "splithttp" -> "xhttp"
             "kcp" -> "mkcp"
             else -> p.network
         }
diff --git a/app/src/test/java/com/picosoft/xrayproxydroid/TransportBuildTest.kt b/app/src/test/java/com/picosoft/xrayproxydroid/TransportBuildTest.kt
index 826ecf6..6c2e89a 100644
--- a/app/src/test/java/com/picosoft/xrayproxydroid/TransportBuildTest.kt
+++ b/app/src/test/java/com/picosoft/xrayproxydroid/TransportBuildTest.kt
@@ -121,6 +121,17 @@ class TransportBuildTest {
         assertTrue("json balanced", balanced(cfg))
     }
 
+    @Test fun splithttp_normalizes_to_xhttp() {
+        // Находка порта Windows №1: splithttp (старое имя xhttp) падал «unsupported transport» (и из ссылки, и из JSON).
+        val p = vless("vless://11111111-1111-1111-1111-111111111111@h.example.com:443?type=splithttp&path=%2Fsp&host=cdn.example.com&security=tls&sni=cdn.example.com#n")
+        assertEquals("splithttp", p.network)   // сырьё в профиле НЕ трогаем (serverKey стабилен)
+        val cfg = XrayConfigBuilder.build(p)
+        assertTrue(cfg.contains("\"network\": \"xhttp\""))
+        assertTrue(cfg.contains("\"xhttpSettings\""))
+        assertTrue(cfg.contains("\"path\": \"/sp\""))
+        assertTrue("json balanced", balanced(cfg))
+    }
+
     @Test fun still_supports_ws_grpc() {
         val ws = XrayConfigBuilder.build(vless("vless://11111111-1111-1111-1111-111111111111@h:443?type=ws&path=%2Fw&host=x.com&security=tls&sni=x.com#n"))
         assertTrue(ws.contains("\"wsSettings\""))
