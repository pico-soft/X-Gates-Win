fetchViaTempInstance: исключение core.startLoop (ядро не стартует — напр. битый ключ reality в подписке:
«Failed to build REALITY config… invalid "password"») не ловилось (try/finally без catch) → летело из
CascadeFetch.fetch наружу и обрывало ВЕСЬ каскад (ступень 6), остальные «недавно рабочие» кандидаты не
пробовались. Теперь это провал одного кандидата: null → каскад идёт к следующему.

Найдено при порте на Windows (X-Gates-Win, docs/decisions.md «Найдено в Android-коде» №4); там воспроизведено
тестом с настоящим ядром (битый reality первым, живой вторым) и проверено после правки.
---
 .../com/picosoft/xrayproxydroid/xray/ServerSpeedTester.kt     | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/app/src/main/java/com/picosoft/xrayproxydroid/xray/ServerSpeedTester.kt b/app/src/main/java/com/picosoft/xrayproxydroid/xray/ServerSpeedTester.kt
index 073c199..471916f 100644
--- a/app/src/main/java/com/picosoft/xrayproxydroid/xray/ServerSpeedTester.kt
+++ b/app/src/main/java/com/picosoft/xrayproxydroid/xray/ServerSpeedTester.kt
@@ -368,6 +368,10 @@ object ServerSpeedTester {
                 if (res.bodyBytes > 0) TrafficTracker.addTest(res.bodyBytes.toLong())
                 log("«$name» fetchViaTempInstance http=${res.httpCode} bytes=${res.bodyBytes}")
                 return res
+            } catch (e: Exception) {
+                // Находка порта Windows №4: исключение startLoop (битый конфиг сервера — ядро не стартует) раньше летело
+                // наружу и обрывало ВЕСЬ каскад загрузки. Теперь это провал ОДНОГО кандидата: null → каскад берёт следующего.
+                log("«$name» fetchViaTempInstance ядро не стартовало: ${e.message}"); return null
             } finally {
                 try { core.stopLoop() } catch (e: Exception) { /* ignore */ }
             }
