~1.5% реальных vmess-ссылок приходят как `vmess://<base64>=?remarks=…` (хвост без &, поэтому детект
query-формата их не откладывает). Хвост уходил в Base64.decode → исключение → сервер молча отброшен.
Теперь декодируем часть до «?»; хвост не нужен (имя сервера — в "ps" JSON). Ссылки с ? и & (vmess-std)
по-прежнему откладываются.

Найдено при порте на Windows (X-Gates-Win, docs/decisions.md «Найдено в Android-коде» №2).
---
 .../com/picosoft/xrayproxydroid/xray/link/VmessParser.kt     | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/picosoft/xrayproxydroid/xray/link/VmessParser.kt b/app/src/main/java/com/picosoft/xrayproxydroid/xray/link/VmessParser.kt
index bb82f9d..ada0bab 100644
--- a/app/src/main/java/com/picosoft/xrayproxydroid/xray/link/VmessParser.kt
+++ b/app/src/main/java/com/picosoft/xrayproxydroid/xray/link/VmessParser.kt
@@ -20,9 +20,12 @@ object VmessParser : LinkParser {
 
         // Детект query-формата (vmess-std) по наличию ? и & — откладываем, не крашим.
         if (body.contains('?') && body.contains('&')) return null
+        // Находка порта Windows №2: ~1.5% реальных ссылок — `vmess://<base64>=?хвост` (без &): хвост ломал Base64 и
+        // сервер отбрасывался. Base64-часть — до «?», хвост не нужен (имя — в "ps" JSON).
+        val b64 = body.substringBefore('?')
 
         val json = try {
-            val padded = body + "=".repeat((4 - body.length % 4) % 4) // паддинг до кратности 4
+            val padded = b64 + "=".repeat((4 - b64.length % 4) % 4) // паддинг до кратности 4
             String(Base64.decode(padded, Base64.DEFAULT), Charsets.UTF_8)
         } catch (e: Exception) {
             return null
