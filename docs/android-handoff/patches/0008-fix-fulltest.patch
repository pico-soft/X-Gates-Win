onRemoveCurrent ставит активный сервер на паузу и запускает полный тест, но FullTestRunner брал АКТИВНЫЙ сервер
«в норме» инкумбентом, не глядя на паузу → переключение только если кандидат в keepBestMultiplier раз быстрее.
Итог: туннель оставался на сервере, который пользователь попросил не использовать. Теперь отложенный активный НЕ
инкумбент: тест подключает лучший разрешённый кандидат (сам отложенный кандидатом и раньше не был). Нет ни одного
рабочего — туннель остаётся как был (лучше, чем без связи).

Найдено при порте на Windows (X-Gates-Win, docs/decisions.md «Найдено в Android-коде» №8); там проверено тестом
модели «Главной» с настоящим ядром (два сервера равной скорости): до правки туннель оставался на отложенном,
после — переключился на второй.
---
 .../com/picosoft/xrayproxydroid/xray/FullTestRunner.kt     | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/picosoft/xrayproxydroid/xray/FullTestRunner.kt b/app/src/main/java/com/picosoft/xrayproxydroid/xray/FullTestRunner.kt
index 3a5f681..f78c4a0 100644
--- a/app/src/main/java/com/picosoft/xrayproxydroid/xray/FullTestRunner.kt
+++ b/app/src/main/java/com/picosoft/xrayproxydroid/xray/FullTestRunner.kt
@@ -196,7 +196,12 @@ object FullTestRunner {
                         ServerSpeedTester.measureSpeed(appCtx, activeProfile) else -1.0
                     if (activeProfile != null && activeMbps > 0.0) onSpeedResult(activeProfile, activeMbps, true)   // measureSpeed — полный; в «Живые»
                     beat()
-                    if (activeProfile != null && activeMbps >= s.monitorTunnelThreshold) {
+                    // Находка порта Windows №8: активный, поставленный на паузу («Не использовать»), НЕ инкумбент — иначе
+                    // кнопка ничего не переключала (замена должна была быть в keepBestMultiplier раз быстрее).
+                    val activePaused = activeProfile != null && ServerFilter.isPaused(activeProfile, blocklist)
+                    if (activePaused) {
+                        onPhase("Активный ${label(activeProfile!!)} отложен («Не использовать») — ищу замену")
+                    } else if (activeProfile != null && activeMbps >= s.monitorTunnelThreshold) {
                         connected = activeProfile; connectedSpeed = activeMbps; hbConnected.set(activeProfile); keepActive = true
                         onPhase("Активный ${label(activeProfile)}: ↓${fmt(activeMbps)} Мбит/с (в норме) — переключусь только если кандидат ×${fmt(s.keepBestMultiplier)} быстрее")
                     } else {
