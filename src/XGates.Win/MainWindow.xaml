<Window x:Class="XGates.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-Gates Win" Width="600" Height="645" MinWidth="460" MinHeight="500"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <Window.Resources>
        <!-- Строка списка серверов (ServerRow Kotlin): имя + подпись · пинг и давность · скорость и давность · глаз · ▶ -->
        <DataTemplate x:Key="ServerRow">
            <Border Background="{Binding RowBg}" CornerRadius="6" Padding="8,5" Margin="0,1"
                    BorderBrush="#14000000" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                                Tag="{Binding}" MouseLeftButtonUp="OnRowDetails" ToolTip="Подробности">
                        <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}" Foreground="{Binding TitleBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Caption}" Foreground="{StaticResource Gray}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding CaptionVisibility}" />
                        <TextBlock Text="{Binding PingText}" Foreground="{StaticResource Gray}" FontSize="11" Visibility="{Binding PingVisibility}" />
                        <TextBlock Text="{Binding PingAge}" Foreground="{StaticResource Gray}" FontSize="11" Visibility="{Binding PingAgeVisibility}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding EyeText}" ToolTip="{Binding EyeTip}" Click="OnToggleUse" Tag="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="6,2" Margin="4,0" VerticalAlignment="Center"
                            FontSize="11" Foreground="{Binding EyeBrush}" />
                    <StackPanel Grid.Column="2" Width="96" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SpeedText}" Foreground="{Binding SpeedBrush}" FontWeight="{Binding SpeedWeight}" TextAlignment="Right" />
                        <TextBlock Text="{Binding SpeedAge}" Foreground="{StaticResource Gray}" FontSize="11" TextAlignment="Right" Visibility="{Binding SpeedAgeVisibility}" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="{Binding ConnectGlyph}" ToolTip="Подключиться" Click="OnConnect" Tag="{Binding}"
                            Width="30" Height="30" Margin="8,0,0,0" Padding="0" Foreground="White" Background="{StaticResource Accent}"
                            BorderThickness="0" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="0" BorderThickness="0,1,0,0">
        <!-- ═══ ГЛАВНАЯ ═══ -->
        <TabItem Header="  Главная  ">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,10">
                    <!-- Полоса «было падение» (93.I) -->
                    <Border x:Name="CrashBanner" Background="#7F1D1D" CornerRadius="10" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Foreground="#FFCDD2" FontWeight="Bold" TextWrapping="Wrap" Text="Приложение аварийно завершилось — сохранён отчёт о сбое." />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Отправить разработчику" Click="OnCrashSend" />
                                <Button Content="Скопировать" Click="OnCrashCopy" />
                                <Button Content="Закрыть" Click="OnCrashDismiss" />
                            </WrapPanel>
                            <TextBlock Foreground="#FFCDD2" FontSize="11" Margin="0,6,0,0" Text="Данные пересылаются только по вашему решению." />
                        </StackPanel>
                    </Border>
                    <!-- Полоса «новая версия» (93.K): одно нажатие = проверить → скачать → проверить подпись → установить -->
                    <Border x:Name="UpdateBanner" Background="#0D47A1" CornerRadius="10" Padding="12" Margin="0,0,0,10" Visibility="Collapsed"
                            Cursor="Hand" MouseLeftButtonUp="OnUpdateBannerClick">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="White" FontWeight="Bold" Text="✕" Padding="8,0" MouseLeftButtonUp="OnUpdateDismiss" />
                            <StackPanel>
                                <TextBlock Foreground="White" FontWeight="Bold" Text="Доступна новая версия" />
                                <TextBlock x:Name="UpdateBannerText" Foreground="#BBDEFB" TextWrapping="Wrap" Text="Нажмите, чтобы обновить" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Пауза «Только Wi-Fi» -->
                    <Border x:Name="PausedBanner" Background="#263238" CornerRadius="10" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Foreground="#80DEEA" FontWeight="Bold" Text="Пауза — жду Wi-Fi" />
                            <TextBlock Foreground="#80DEEA" TextWrapping="Wrap" Text="Включён режим «Только Wi-Fi». На мобильной сети туннель остановлен — поднимется сам, как появится Wi-Fi." />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="AddSubscriptionHint" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15" Text="Добавьте вашу подписку" />
                        <TextBlock Foreground="{StaticResource Gray}" TextWrapping="Wrap" Text="Вкладка «Подписки» → вставьте ссылку или URL. Без подписки список серверов пуст." />
                    </StackPanel>

                    <!-- ПЛАШКА активного сервера (StatusBox): цвет — по скорости и факту связи -->
                    <Border x:Name="StatusBox" CornerRadius="10" Padding="14,12" Background="#3A3A3A">
                        <StackPanel x:Name="StatusPanel">
                            <TextBlock x:Name="StatusTitle" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusDirect" FontSize="12" />
                            <TextBlock x:Name="StatusTunnel" FontSize="12" />
                            <TextBlock x:Name="StatusLine" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusBlocked" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"
                                       Text="⛔ Активный сервер в стоп-листе. Живое соединение НЕ разрываем — переключиться: кнопка «Самый быстрый»." />
                            <TextBlock x:Name="StatusHidden" FontSize="12" FontWeight="Bold" Text="⚠ протокол скрыт настройками" />
                            <TextBlock x:Name="StatusSubtitle" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusIp" FontWeight="Bold" Cursor="Hand" ToolTip="Обновить" MouseLeftButtonUp="OnRefreshIp" />
                            <TextBlock x:Name="StatusMessage" FontSize="12" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="CheckButton" Content="Проверить" Click="OnCheck" Padding="8,2" FontSize="12" />
                                <Button x:Name="ExcludeButton" Content="Не использовать" Click="OnExclude" Padding="8,2" FontSize="12" />
                            </WrapPanel>
                            <ProgressBar x:Name="CheckProgress" IsIndeterminate="True" Height="2" Margin="0,6,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="CheckStatus" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ModeLine" Style="{StaticResource Link}" MouseLeftButtonUp="OnModeLine" />
                    <TextBlock x:Name="StopWordsLine" Style="{StaticResource Link}" MouseLeftButtonUp="OnStopWords" />
                    <Border x:Name="WhiteListBanner" Background="#FFF3E0" CornerRadius="8" Padding="10" Margin="0,6" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Обычный режим" Click="OnWhiteListNormal" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="Включены «Белые списки»: рабочих серверов не было — подключены серверы белого списка." />
                        </DockPanel>
                    </Border>

                    <!-- ДЕЙСТВИЯ (ActionsBar) -->
                    <WrapPanel Margin="0,10,0,4">
                        <Button x:Name="FastestButton" Style="{StaticResource Primary}" Click="OnFastest" Content="▶  Самый быстрый" />
                        <Button x:Name="StopButton" Click="OnStop" Content="■  Стоп" VerticalAlignment="Center" />
                    </WrapPanel>
                    <ProgressBar x:Name="TestBar" Height="4" Margin="0,4,0,0" Visibility="Collapsed" Maximum="1" />
                    <TextBlock x:Name="TestPhase" Foreground="{StaticResource Gray}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubStatus" FontSize="12" TextWrapping="Wrap" />

                    <!-- ЖИВЫЕ -->
                    <Border Background="{StaticResource LiveBg}" CornerRadius="10" Padding="8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LiveHeader" FontWeight="Bold" FontSize="15" Margin="4,0,0,4" />
                            <TextBlock x:Name="HiddenNote" Foreground="{StaticResource Gray}" FontSize="12" Margin="4,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="NoProtocolsNote" Foreground="#C62828" FontSize="12" Margin="4,0" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="Все протоколы выключены в настройках — список пуст. Включите хотя бы один протокол." />
                            <TextBlock x:Name="HiddenLiveNote" Foreground="#E8710A" FontSize="12" FontWeight="Bold" Margin="4,0" TextWrapping="Wrap" Visibility="Collapsed"
                                       Cursor="Hand" MouseLeftButtonUp="OnShowHiddenProtocols" />
                            <ItemsControl x:Name="LiveList" ItemTemplate="{StaticResource ServerRow}" />
                            <TextBlock x:Name="LiveEmpty" Foreground="{StaticResource Gray}" Margin="4,6" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- РАНЕЕ ИЗМЕРЕННЫЕ (развёрнуто по умолчанию) -->
                    <Border x:Name="PrevBox" Background="{StaticResource PrevBg}" CornerRadius="10" Padding="8" Margin="0,12,0,0">
                        <Expander x:Name="PrevExpander" IsExpanded="True" FontWeight="Bold" FontSize="15" Expanded="OnAllExpanded">
                            <ItemsControl x:Name="PrevList" ItemTemplate="{StaticResource ServerRow}" FontWeight="Normal" FontSize="13" />
                        </Expander>
                    </Border>
                    <!-- ВСЕ СЕРВЕРЫ (свёрнуто; список строится только при раскрытии — их бывают тысячи) -->
                    <Border Background="{StaticResource AllBg}" CornerRadius="10" Padding="8" Margin="0,12,0,14">
                        <Expander x:Name="AllExpander" IsExpanded="False" FontWeight="Bold" FontSize="15"
                                  Expanded="OnAllExpanded" Collapsed="OnAllCollapsed">
                            <ListBox x:Name="AllList" ItemTemplate="{StaticResource ServerRow}" MaxHeight="640" FontWeight="Normal" FontSize="13"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══ ПОДПИСКИ ═══ -->
        <TabItem Header="  Подписки  ">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,10">
                    <Border x:Name="SeedCard" Background="#E3F2FD" CornerRadius="10" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="Рекомендуемый список серверов не загрузился" />
                            <TextBlock x:Name="SeedError" TextWrapping="Wrap" Margin="0,4" />
                            <Button x:Name="SeedRetry" Content="Повторить" Click="OnSeedRetry" HorizontalAlignment="Left" Margin="0,4" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Gray}"
                                       Text="Или вставьте конфигурацию текстом ниже (поле «Вставить ссылки текстом») — её можно принести из мессенджера или от другого устройства. Это единственный способ начать в заблокированной сети." />
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="SubsRefresh" DockPanel.Dock="Right" Content="↻  Обновить" Click="OnSubsRefresh" Margin="0" />
                        <TextBlock x:Name="SubsHeader" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="SubsStatus" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" />
                    <ItemsControl x:Name="SourcesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnSourceToggle" Tag="{Binding}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0" ToolTip="Включить / выключить источник" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Url}" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Problem}" ToolTip="{Binding ProblemTip}" Foreground="#C62828" FontSize="12" TextWrapping="Wrap" Visibility="{Binding ProblemVisibility}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <Button Content="Имя…" Click="OnSourceRename" Tag="{Binding}" Padding="8,2" Margin="0,0,0,4" />
                                            <Button Content="Удалить" Click="OnSourceDelete" Tag="{Binding}" Padding="8,2" Margin="0" Foreground="#C62828" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoSources" Text="Подписок пока нет." Foreground="{StaticResource Gray}" Visibility="Collapsed" />

                    <TextBlock Style="{StaticResource Section}" Text="Добавить подписку" />
                    <TextBlock Text="Адрес подписки" Foreground="{StaticResource Gray}" />
                    <TextBox x:Name="NewUrl" Margin="0,0,0,6" ToolTip="https://…" />
                    <TextBlock Text="Название (можно не заполнять)" Foreground="{StaticResource Gray}" />
                    <TextBox x:Name="NewName" Margin="0,0,0,6" />
                    <Button Content="Добавить и обновить" Click="OnAddUrl" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource Section}" Text="Вставить ссылки текстом" />
                    <TextBox x:Name="Paste" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                             ToolTip="vless:// vmess:// trojan:// ss:// или base64-подписка" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Content="Добавить из текста" Click="OnAddPaste" />
                        <Button Content="Импорт из файла…" Click="OnImportFile" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══ НАСТРОЙКИ ═══ -->
        <TabItem x:Name="SettingsTab" Header="  Настройки  ">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,10">
                    <TextBlock Style="{StaticResource Section}" Margin="0,0,0,6" Text="Локальный прокси" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Gray}"
                               Text="Приложение НЕ меняет системный прокси Windows. Укажите адрес в браузере/программе вручную (или через расширение браузера)." />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Адрес" Foreground="{StaticResource Gray}" Margin="0,0,0,2" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Порт" Foreground="{StaticResource Gray}" Margin="0,0,0,2" />
                        <TextBlock Grid.Row="1" Text="SOCKS5" VerticalAlignment="Center" Margin="0,0,12,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="127.0.0.1" VerticalAlignment="Center" Margin="0,0,0,4" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Копировать" Click="OnCopyAddress" Margin="8,0,16,4" Padding="8,1" />
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="SocksPort" Margin="0,0,0,4" />
                        <Button Grid.Row="1" Grid.Column="4" Content="Копировать" Click="OnCopySocks" Margin="8,0,0,4" Padding="8,1" />
                        <TextBlock Grid.Row="2" Text="HTTP и HTTPS" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="127.0.0.1" VerticalAlignment="Center" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Копировать" Click="OnCopyAddress" Margin="8,0,16,0" Padding="8,1" />
                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="HttpPort" />
                        <Button Grid.Row="2" Grid.Column="4" Content="Копировать" Click="OnCopyHttp" Margin="8,0,0,0" Padding="8,1" />
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Применить порты" Click="OnApplyPorts" />
                        <Button Content="По умолчанию (10815 / 10816)" Click="OnDefaultPorts" />
                    </WrapPanel>
                    <TextBlock x:Name="PortsStatus" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <!-- Рабочий браузер — Firefox (решение Elyor): прокси в его обычный профиль одной кнопкой (FirefoxSetup). -->
                    <TextBlock Style="{StaticResource Section}" Margin="0,10,0,6" Text="Firefox" />
                    <WrapPanel>
                        <Button Content="Настроить Firefox" Click="OnFirefoxSetup" />
                        <Button Content="Вернуть как было" Click="OnFirefoxRestore" />
                    </WrapPanel>
                    <TextBlock x:Name="FirefoxStatus" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Gray}" />

                    <!-- Как в Android (BrowserSetupSection): сервер и порт копируются отдельно и видны сразу. -->
                    <TextBlock Style="{StaticResource Section}" Margin="0,10,0,6" Text="Telegram" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Настройки → Продвинутые настройки → Тип соединения → «Использовать собственный прокси» → SOCKS5. Впишите сервер и порт:" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Сервер" VerticalAlignment="Center" Margin="0,0,12,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="127.0.0.1" VerticalAlignment="Center" Margin="0,0,0,4" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Копировать" Click="OnCopyAddress" Margin="8,0,0,4" Padding="8,1" />
                        <TextBlock Grid.Row="1" Text="Порт" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TelegramPort" VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Копировать" Click="OnCopySocks" Margin="8,0,0,0" Padding="8,1" />
                    </Grid>
                    <TextBlock Foreground="{StaticResource Gray}" Margin="0,4,0,0" Text="Логин и пароль оставьте пустыми." />
                    <!-- Как направить программы в наш прокси (аналог BrowserSetupSection Android). Системный прокси НЕ трогаем. -->
                    <Expander Header="Как подключить другие программы" Margin="0,8,0,0" FontWeight="Bold">
                        <TextBox x:Name="HowToText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 FontWeight="Normal" Margin="0,6,0,0" />
                    </Expander>

                    <TextBlock Style="{StaticResource Section}" Text="Запуск" />
                    <CheckBox x:Name="LaunchAtLogin" Content="Запускать при входе в Windows (в трее, с последним сервером)" Click="OnLaunchAtLogin" Margin="0,2" />

                    <TextBlock Style="{StaticResource Section}" Text="Обход блокировок" />
                    <CheckBox x:Name="TlsFragment" Content="Дробить начало TLS-соединения на части" Click="OnTlsFragment" Margin="0,2" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Gray}"
                               Text="Включайте, если серверы перестали подключаться: помогает, когда блокируют по имени сайта в начале соединения. Подключение и замеры станут чуть медленнее (примерно на 0,15 с)." />
                    <TextBlock x:Name="TlsFragmentStatus" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Style="{StaticResource Section}" Text="Протоколы" />
                    <WrapPanel x:Name="ProtocolsPanel" />

                    <TextBlock Style="{StaticResource Section}" Text="Параметры" />
                    <StackPanel x:Name="ParamsPanel" />
                    <Button Content="Сбросить настройки к значениям по умолчанию" Click="OnResetSettings" HorizontalAlignment="Left" Margin="0,8,0,0" />

                    <TextBlock Style="{StaticResource Section}" Text="Автомониторинг" />
                    <TextBlock x:Name="HeartbeatLine" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock FontWeight="Bold" Margin="0,10,0,4" Text="Периодический перемер и проверки" />
                    <StackPanel x:Name="OptimizePanel" />
                    <DockPanel Margin="0,8,0,4">
                        <Button DockPanel.Dock="Right" Content="Очистить" Click="OnClearJournal" Padding="8,1" Margin="0" />
                        <Button DockPanel.Dock="Right" Content="Скопировать журнал" Click="OnCopyJournal" Padding="8,1" Margin="0,0,6,0" />
                        <TextBlock x:Name="JournalTitle" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="JournalPanel" />

                    <TextBlock Style="{StaticResource Section}" Text="Трафик" />
                    <StackPanel x:Name="TrafficPanel" />
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Сбросить: с запуска" Click="OnResetTrafficSession" />
                        <Button Content="Сбросить: за сутки" Click="OnResetTrafficToday" />
                        <Button Content="Стереть всю историю" Click="OnResetTrafficAll" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Стоп-лист" />
                    <TextBlock Foreground="{StaticResource Gray}" TextWrapping="Wrap" Text="Слово (часть имени) скрывает совпавшие серверы. Регистр не важен." />
                    <WrapPanel x:Name="WordsPanel" Margin="0,6,0,0" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="+" Click="OnAddWord" Margin="6,0,0,0" Padding="12,2" />
                        <TextBox x:Name="NewWord" ToolTip="Слово" />
                    </DockPanel>
                    <TextBlock FontWeight="Bold" Margin="0,10,0,4" Text="Персонально заблокированные" />
                    <StackPanel x:Name="BlockedPanel" />

                    <TextBlock Style="{StaticResource Section}" Text="Обновления" />
                    <TextBlock x:Name="UpdateSummary" TextWrapping="Wrap" Margin="0,4" />
                    <WrapPanel>
                        <Button x:Name="UpdateCheckButton" Content="Проверить обновление" Click="OnUpdateCheck" />
                        <Button x:Name="UpdateInstallButton" Content="Скачать и установить" Click="OnUpdateInstall" Visibility="Collapsed" />
                        <Button x:Name="UpdateCancelButton" Content="Отменить" Click="OnUpdateCancel" Visibility="Collapsed" />
                        <Button Content="Подробности" Click="OnUpdateDetails" />
                    </WrapPanel>
                    <TextBlock x:Name="UpdatePhase" TextWrapping="Wrap" Margin="0,4" FontWeight="Bold" />

                    <TextBlock Style="{StaticResource Section}" Text="Отчёты о сбоях" />
                    <TextBlock x:Name="CrashSummary" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,4">
                        <Button Content="Открыть папку отчётов" Click="OnOpenCrashDir" />
                        <Button Content="Удалить все" Click="OnClearCrashes" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Section}" Text="О приложении" />
                    <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,6,0,20">
                        <Button Content="Папка данных" Click="OnOpenDataDir" />
                        <Button Content="Журнал" Click="OnOpenLog" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
